{
  "name": "arc-mev-bot",
  "version": "0.1.0",
  "private": true,
  "description": "State-based arbitrage MEV bot for Circle's Arc L1 (Uniswap v4 flash-accounting cycles)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "bot": "tsx src/main.ts",
    "discover": "tsx src/cli/discover.ts",
    "scan": "tsx src/cli/scan.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "viem": "^2.56.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
