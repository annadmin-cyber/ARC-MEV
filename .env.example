# ---- network ----
CHAIN_ID=5042
RPC_URL=https://rpc.mainnet.arc.io
# The repo ships a pool snapshot (data/pools.5042.json.gz), so `npm run discover` only scans the
# blocks since the snapshot and Blockdaemon (about a day of log history) is enough. Set this only
# for a from-scratch scan of the whole history: it must then serve 10,000-block eth_getLogs ranges
# over every block (NodeFlare's archive does with a free API key; its keyless endpoint blocks
# eth_getLogs for some clients; the official gateway throttles, dRPC free caps ranges at ~100 blocks).
#DISCOVER_RPC_URL=
# JSON-RPC batching for the main HTTP client. 0 = single requests (safe everywhere); set e.g. 20
# only on a keyed provider that accepts batches.
RPC_BATCH=0
# Optional but strongly recommended: a WebSocket endpoint makes the bot react to new blocks immediately.
# The official one delivered heads first for 87% of blocks in our measurements.
#WS_URL=wss://rpc.mainnet.arc.io/ws
# For reads/simulation prefer Blockdaemon or dRPC over the official gateway (its HTTP path lags its own
# WebSocket by ~300 ms and rate-limits hard):
#RPC_URL=https://rpc.blockdaemon.mainnet.arc.io
# Optional extra WebSocket endpoints (comma-separated). Every endpoint's newHeads race; duplicates are dropped.
#WS_URLS=wss://rpc.blockdaemon.mainnet.arc.io/websocket,wss://rpc.drpc.mainnet.arc.io
# No head over WebSocket for this long (ms) -> poll eth_blockNumber until heads resume.
WS_STALL_MS=3000

# ---- keys & contracts (only needed when DRY_RUN=false) ----
#PRIVATE_KEY=0x...
#EXECUTOR_ADDRESS=0x...

# ---- safety ----
DRY_RUN=true
MIN_PROFIT_USDC_WEI=150000000000000000     # 0.15 USDC (18 decimals); median winning arb on launch day netted 0.13
MAX_INPUT_USDC_WEI=5000000000000000000000  # 5000 USDC
GAS_SAFETY=1.5
# Arc orders transactions by priority fee (highest tip first). Base fee floats ~20-20000 gwei.
MAX_FEE_PER_GAS_WEI=25000000000000         # 25,000 gwei hard cap
TIP_SHARE=0.3                              # bid up to 30% of expected profit as priority fee (winners paid ~7% of gross)
MAX_PRIORITY_FEE_WEI=5000000000000         # 5,000 gwei hard cap (slot-0 tips are ~200-350 gwei p50)
MIN_PRIORITY_FEE_WEI=100000000000          # 100 gwei floor
GAS_LIMIT=1500000                          # upper bound / fallback when estimation fails
QUOTE_GAS=400000                           # gas assumed when quoting profitability pre-simulation
GUARD_TOLERANCE_BPS=1                      # revert cheaply if a pool moved > 1 bp since simulation
# Circuit breaker: after this many consecutive reverted or lost transactions, pause sending ...
MAX_CONSECUTIVE_REVERTS=3
# ... for this many blocks (120 blocks = ~1 minute).
BREAKER_PAUSE_BLOCKS=120
# Rolling gas budget: once this much USDC (18 decimals) of gas was paid within the window, only dry-run.
GAS_BUDGET_USDC_WEI=5000000000000000000    # 5 USDC
GAS_BUDGET_WINDOW_BLOCKS=7200              # ~1 hour of 500 ms blocks
# Optional extra endpoints that also receive the signed tx (comma-separated), for speed and redundancy.
# The official gateway is the fastest send path but allows ~1 send/s; Blockdaemon showed no limit.
#SEND_RPC_URLS=https://rpc.mainnet.arc.io,https://rpc.blockdaemon.mainnet.arc.io

# ---- pool selection ----
# Liquidity L scales with sqrt(units0 * units1): the deepest pool on Arc (cirBTC/USDC 0.01% v3, 8 x 6 decimals,
# ~$10M) has L ~ 4e11, an 18-decimal pair with $130k has L ~ 1.6e18. v2 pairs count isqrt(reserve0 * reserve1).
MIN_POOL_LIQUIDITY=100000000
MAX_TRACKED_POOLS=300
ALLOWED_HOOKS=
START_CURRENCIES=0x0000000000000000000000000000000000000000:18,0x3600000000000000000000000000000000000000:6
FULL_REFRESH_BLOCKS=200
TICK_WORDS_EACH_SIDE=2
POLL_INTERVAL_MS=250

# ---- hooked-pool probing (V4Quoter) ----
# Hooked v4 pools cannot be simulated locally; when a probed hooked pool trades, its 2-hop cycles
# against tracked pools on the same pair are quoted through V4Quoter.quoteExactInput. In the default
# multicall mode a block's quotes travel in one Multicall3.aggregate3 eth_call (one request per round
# on any provider); PROBE_QUOTE_MODE=batch issues one eth_call per quote in JSON-RPC batches of 20,
# each of which counts against the RPC's rate limit (the public gateway allows ~10 req/s): in that
# mode use PROBE_MAX_PER_BLOCK=1 and PROBE_GRID=3 on rpc.mainnet.arc.io.
PROBE_HOOKED_POOLS=true
PROBE_MAX_PER_BLOCK=4                      # (hooked, tracked) pool pairs quoted per block, most-spread first
PROBE_MIN_SPREAD_BPS=30                    # only probe when the spot prices differ by more than this
PROBE_GRID=5                               # log-spaced input amounts per quoted cycle (one quoter round)
PROBE_QUOTE_MODE=multicall                 # multicall: one aggregate3 eth_call per round (default); batch: one eth_call per quote

# ---- live monitor ----
# Built-in status page (HTML), JSON at /api/status and Prometheus text at /metrics. 0 = disabled.
# No authentication: keep MONITOR_HOST on localhost and view it through an SSH tunnel
# (`ssh -L 3000:127.0.0.1:3000 user@host`, then open http://localhost:3000).
MONITOR_PORT=0
MONITOR_HOST=127.0.0.1

DATA_DIR=data
LOG_LEVEL=info
