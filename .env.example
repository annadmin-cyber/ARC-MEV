# ---- network ----
CHAIN_ID=5042
RPC_URL=https://rpc.mainnet.arc.io
# Optional. A WebSocket endpoint makes the bot react to new blocks immediately.
# e.g. wss://rpc.quicknode.mainnet.arc.io or wss://arc-mainnet.g.alchemy.com/v2/KEY
#WS_URL=
# Optional extra WebSocket endpoints (comma-separated). Every endpoint's newHeads race; duplicates are dropped.
#WS_URLS=wss://rpc.blockdaemon.mainnet.arc.io/websocket,wss://rpc.drpc.mainnet.arc.io
# No head over WebSocket for this long (ms) -> poll eth_blockNumber until heads resume.
WS_STALL_MS=3000

# ---- keys & contracts (only needed when DRY_RUN=false) ----
#PRIVATE_KEY=0x...
#EXECUTOR_ADDRESS=0x...

# ---- safety ----
DRY_RUN=true
MIN_PROFIT_USDC_WEI=50000000000000000      # 0.05 USDC (18 decimals)
MAX_INPUT_USDC_WEI=5000000000000000000000  # 5000 USDC
GAS_SAFETY=1.5
# Arc orders transactions by priority fee (highest tip first). Base fee floats ~20-20000 gwei.
MAX_FEE_PER_GAS_WEI=25000000000000         # 25,000 gwei hard cap
TIP_SHARE=0.5                              # bid up to 50% of expected profit as priority fee
MAX_PRIORITY_FEE_WEI=10000000000000        # 10,000 gwei hard cap
MIN_PRIORITY_FEE_WEI=25000000000           # 25 gwei floor
GAS_LIMIT=1500000                          # upper bound / fallback when estimation fails
QUOTE_GAS=400000                           # gas assumed when quoting profitability pre-simulation
GUARD_TOLERANCE_BPS=1                      # revert cheaply if a pool moved > 1 bp since simulation
# Circuit breaker: after this many consecutive reverted or lost transactions, pause sending ...
MAX_CONSECUTIVE_REVERTS=3
# ... for this many blocks (120 blocks = ~1 minute).
BREAKER_PAUSE_BLOCKS=120
# Rolling gas budget: once this much USDC (18 decimals) of gas was paid within the window, only dry-run.
GAS_BUDGET_USDC_WEI=5000000000000000000    # 5 USDC
GAS_BUDGET_WINDOW_BLOCKS=7200              # ~1 hour of 500 ms blocks
# Optional extra endpoints that also receive the signed tx (comma-separated), for speed and redundancy.
#SEND_RPC_URLS=https://rpc.quicknode.mainnet.arc.io,https://rpc.blockdaemon.mainnet.arc.io,https://rpc.drpc.mainnet.arc.io

# ---- pool selection ----
# Liquidity L scales with sqrt(units0 * units1): the deepest pool on Arc (cirBTC/USDC 0.01% v3, 8 x 6 decimals,
# ~$10M) has L ~ 4e11, an 18-decimal pair with $130k has L ~ 1.6e18. v2 pairs count isqrt(reserve0 * reserve1).
MIN_POOL_LIQUIDITY=100000000
MAX_TRACKED_POOLS=300
ALLOWED_HOOKS=
START_CURRENCIES=0x0000000000000000000000000000000000000000:18,0x3600000000000000000000000000000000000000:6
FULL_REFRESH_BLOCKS=200
TICK_WORDS_EACH_SIDE=2
POLL_INTERVAL_MS=250

# ---- hooked-pool probing (V4Quoter) ----
# Hooked v4 pools cannot be simulated locally; when a probed hooked pool trades, its 2-hop cycles
# against tracked pools on the same pair are quoted through V4Quoter.quoteExactInput.
# Every quote is one eth_call against the RPC's rate limit (the public gateway allows ~10 req/s):
# on rpc.mainnet.arc.io use PROBE_MAX_PER_BLOCK=1 and PROBE_GRID=3; keep the defaults on a provider endpoint.
PROBE_HOOKED_POOLS=true
PROBE_MAX_PER_BLOCK=4                      # (hooked, tracked) pool pairs quoted per block, most-spread first
PROBE_MIN_SPREAD_BPS=30                    # only probe when the spot prices differ by more than this
PROBE_GRID=5                               # log-spaced input amounts per quoted cycle (one JSON-RPC batch)
DATA_DIR=data
LOG_LEVEL=info
