# ---- network ----
CHAIN_ID=5042
RPC_URL=https://rpc.mainnet.arc.io
# Optional. A WebSocket endpoint makes the bot react to new blocks immediately.
# e.g. wss://rpc.quicknode.mainnet.arc.io or wss://arc-mainnet.g.alchemy.com/v2/KEY
#WS_URL=

# ---- keys & contracts (only needed when DRY_RUN=false) ----
#PRIVATE_KEY=0x...
#EXECUTOR_ADDRESS=0x...

# ---- safety ----
DRY_RUN=true
MIN_PROFIT_USDC_WEI=50000000000000000      # 0.05 USDC (18 decimals)
MAX_INPUT_USDC_WEI=5000000000000000000000  # 5000 USDC
GAS_SAFETY=1.5
# Arc orders transactions by priority fee (highest tip first). Base fee floats ~20-20000 gwei.
MAX_FEE_PER_GAS_WEI=25000000000000         # 25,000 gwei hard cap
TIP_SHARE=0.5                              # bid up to 50% of expected profit as priority fee
MAX_PRIORITY_FEE_WEI=10000000000000        # 10,000 gwei hard cap
MIN_PRIORITY_FEE_WEI=25000000000           # 25 gwei floor
GAS_LIMIT=1500000
GUARD_TOLERANCE_BPS=1                      # revert cheaply if a pool moved > 1 bp since simulation
# Optional extra endpoints that also receive the signed tx (comma-separated), for speed and redundancy.
#SEND_RPC_URLS=https://rpc.quicknode.mainnet.arc.io,https://rpc.blockdaemon.mainnet.arc.io,https://rpc.drpc.mainnet.arc.io

# ---- pool selection ----
MIN_POOL_LIQUIDITY=1000000000000
MAX_TRACKED_POOLS=300
ALLOWED_HOOKS=
START_CURRENCIES=0x0000000000000000000000000000000000000000:18,0x3600000000000000000000000000000000000000:6
FULL_REFRESH_BLOCKS=200
TICK_WORDS_EACH_SIDE=2
POLL_INTERVAL_MS=250
DATA_DIR=data
LOG_LEVEL=info
